# the wallet paid. To show as verified in the x402 Register, use the agentWallet your ERC-8004 identity registered.
PAY_TO=0xYourAgentWallet
# price per call in USDG (Toll's facilitator takes 0.001 to 100)
PRICE=0.01
# your ERC-8004 agent id on Robinhood Chain (optional; lets payers check who gets paid)
AGENT_ID=

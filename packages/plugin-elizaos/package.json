{
  "name": "@tollxyz/plugin-elizaos",
  "version": "0.5.1",
  "description": "elizaOS plugin: before an agent buys a coin, pays an agent or signs on Robinhood Chain, check it with Toll (coins, devs, LARP, ERC-8004 agents, pre-sign check, Stock Token data). Information only.",
  "license": "MIT",
  "author": "Toll",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/t0ll-xyz/toll-plugins.git",
    "directory": "packages/plugin-elizaos"
  },
  "homepage": "https://t0ll.xyz/agents/plugins",
  "keywords": [
    "elizaos",
    "elizaos-plugin",
    "robinhood-chain",
    "stock-tokens",
    "presign",
    "erc-8265",
    "erc-8004",
    "x402",
    "mcp",
    "ai-agent",
    "rug-check",
    "larp",
    "toll",
    "eliza"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.readme.json && tsx --test tests/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@tollxyz/sdk": "^0.7.1"
  },
  "peerDependencies": {
    "@elizaos/core": "^1.6.0"
  },
  "devDependencies": {
    "@elizaos/core": "^1.7.2",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}

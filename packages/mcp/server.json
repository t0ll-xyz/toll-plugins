{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.t0ll-xyz/toll",
  "title": "Toll",
  "description": "Robinhood Chain checks for agents: coins, devs, ERC-8004 agents, pre-sign check, Stock Token data.",
  "websiteUrl": "https://t0ll.xyz/agents/mcp",
  "repository": {
    "url": "https://github.com/t0ll-xyz/toll-plugins",
    "source": "github",
    "subfolder": "packages/mcp"
  },
  "version": "0.2.2",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@tollxyz/mcp",
      "version": "0.2.2",
      "transport": { "type": "stdio" },
      "environmentVariables": [
        {
          "name": "TOLL_BASE_URL",
          "description": "Toll's base URL (default https://t0ll.xyz)",
          "isRequired": false,
          "isSecret": false,
          "format": "string"
        }
      ]
    }
  ],
  "remotes": [
    { "type": "streamable-http", "url": "https://t0ll.xyz/mcp" }
  ]
}

{
  "name": "@tollxyz/mastra",
  "version": "0.3.0",
  "description": "Mastra tools: before an agent buys a coin, pays an agent or signs on Robinhood Chain, check it with Toll (coins, devs, LARP, ERC-8004 agents, pre-sign check, Stock Token data). Information only.",
  "license": "MIT",
  "author": "Toll",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/t0ll-xyz/toll-plugins.git",
    "directory": "packages/mastra"
  },
  "homepage": "https://t0ll.xyz/agents/plugins",
  "keywords": [
    "mastra",
    "robinhood-chain",
    "stock-tokens",
    "presign",
    "erc-8265",
    "erc-8004",
    "mcp",
    "ai-agent",
    "rug-check",
    "larp",
    "toll"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@tollxyz/sdk": "^0.3.0"
  },
  "peerDependencies": {
    "@mastra/core": ">=1.0.0 <2",
    "zod": "^3.25.76 || ^4.1.8"
  },
  "devDependencies": {
    "@mastra/core": "^1.80.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "zod": "^4.1.8"
  }
}

{
  "name": "@tollxyz/agentkit",
  "version": "0.3.1",
  "description": "Coinbase AgentKit action provider: before an agent buys a coin, pays an agent or signs on Robinhood Chain, check it with Toll (coins, devs, LARP, ERC-8004 agents, pre-sign check, Stock Token data). Information only.",
  "license": "MIT",
  "author": "Toll",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/t0ll-xyz/toll-plugins.git",
    "directory": "packages/agentkit"
  },
  "homepage": "https://t0ll.xyz/agents/plugins",
  "keywords": [
    "agentkit",
    "coinbase",
    "robinhood-chain",
    "stock-tokens",
    "presign",
    "erc-8265",
    "erc-8004",
    "x402",
    "mcp",
    "ai-agent",
    "rug-check",
    "larp",
    "toll"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test \".test-build/tests/*.test.js\"",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@tollxyz/sdk": "^0.3.0"
  },
  "peerDependencies": {
    "@coinbase/agentkit": "^0.10.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@coinbase/agentkit": "^0.10.4",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "zod": "^3.23.8"
  }
}

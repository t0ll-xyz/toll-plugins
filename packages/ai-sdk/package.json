{
  "name": "@tollxyz/ai-sdk",
  "version": "0.1.2",
  "description": "Vercel AI SDK tools: before an agent buys a coin, check who is behind it (Robinhood Chain, Solana, BSC) with Toll. Information only.",
  "license": "MIT",
  "author": "Toll",
  "type": "module",
  "main": "./dist/index.js",

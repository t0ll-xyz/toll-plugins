    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@tollxyz/sdk": "^0.1.1"
  },
  "peerDependencies": {
    "ai": ">=6 <8",
    "zod": "^3.25.76 || ^4.1.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "ai": "^7.0.154",

{
  "name": "@tollxyz/goat-plugin",
  "version": "0.1.1",
  "description": "GOAT SDK plugin: before an agent buys a coin, check who is behind it (Robinhood Chain, Solana, BSC) with Toll. Information only.",
  "license": "MIT",
  "author": "Toll",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/t0ll-xyz/toll-plugins.git",
    "directory": "packages/goat"
  },
  "homepage": "https://t0ll.xyz/agents/plugins",
  "keywords": [
    "goat",
    "goat-sdk",
    "robinhood-chain",
    "solana",
    "bsc",
    "x402",
    "mcp",
    "ai-agent",
    "rug-check",
    "larp",
    "toll"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test \".test-build/tests/*.test.js\"",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@tollxyz/sdk": "^0.1.1"
  },
  "peerDependencies": {
    "@goat-sdk/core": ">=0.5.0 <0.6",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@goat-sdk/core": "^0.5.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "zod": "^3.23.8"
  }
}
